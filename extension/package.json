{
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "bun run build:chrome && bun run build:firefox",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv2",
    "zip": "bun run zip:chrome && bun run zip:firefox",
    "zip:chrome": "wxt zip -b chrome --mv3",
    "zip:firefox": "wxt zip -b firefox --mv2",
    "prepare": "wxt prepare",
    "typecheck": "wxt prepare && tsrs --fast --noEmit",
    "lint": "oxlint --type-aware",
    "lint:ext": "addons-linter .output/firefox-mv2",
    "fmt": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:manifests": "bun scripts/check-manifests.ts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run check:manifests && bun run lint:ext",
    "generate-types": "cd .. && cargo test"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.2",
    "lucide": "^1.77.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@wxt-dev/i18n": "^0.2.9",
    "addons-linter": "^10.16.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsrs": "^7.1.0-beta.tsrs4",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "wxt": "^0.21.5"
  }
}
